# DealForge AI - copy to .env and fill in. NEVER commit .env (it is git-ignored).
APP_NAME="DealForge AI"
APP_ENV=development            # production => refuses to fall back to SQLite
DEBUG=False            # True prints full prompts/tool schemas (very noisy)
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-me

# Database (or set one DATABASE_URL, e.g. postgresql://user:pass@host/db)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=dealforge_db

# LLM. DEMO_MODE=True keeps agents deterministic (no API calls, so tokens/cost show 0).
# To run the LLM-backed CrewAI/ADK agents set DEMO_MODE=False and provide ONE key below.
DEMO_MODE=True
# Provider: auto (Groq if GROQ_API_KEY is set, else Gemini) | groq | gemini
LLM_PROVIDER=auto
# Groq (free tier, no card): https://console.groq.com  -> key starts with gsk_
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (free tier is only ~20 requests/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Max seconds for one LLM agent run; on timeout the agent falls back to the deterministic path.
LLM_TIMEOUT_SECONDS=60
# Prices (USD per 1M tokens) used to compute cost from MEASURED token counts. On a free tier you are not billed,
# so the dashboard cost is a PROJECTED list-price cost. Defaults = Groq llama-3.3-70b-versatile; verify at
# https://groq.com/pricing for the model you set above.
LLM_PRICE_INPUT_PER_M=0.59
LLM_PRICE_OUTPUT_PER_M=0.79
USD_INR_RATE=86.50

# MCP transport: inprocess | stdio (spawns the FastMCP server as a child process)
MCP_TRANSPORT=inprocess

# Google ADK service reached over A2A. Localhost => started in-process automatically (ADK_AUTOSTART).
ADK_SERVICE_HOST=127.0.0.1
ADK_SERVICE_PORT=8001
ADK_TIMEOUT_SECONDS=30
ADK_AUTOSTART=True
# ADK_PUBLIC_URL=http://adk_service:8001   # URL written in the Agent Card when deployed separately

# Procurement policy
AUTO_APPROVAL_THRESHOLD=1000000.00
OVERRUN_TOLERANCE_PERCENTAGE=0.0
DEFAULT_CURRENCY=INR

# Langfuse: leave blank to disable export. Create a project in Langfuse (cloud or self-hosted) to get keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=True
